# Copy to .env and fill in. Never commit .env.
# Google AI Studio -> Get API key
GEMINI_API_KEY=

# GitHub -> Settings -> Developer settings -> Fine-grained tokens
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo,owner/other-repo
GITHUB_LOGIN=your-github-username
# Repo -> Settings -> Webhooks -> Secret (any long random string, same value here)
GITHUB_WEBHOOK_SECRET=

# Notion -> Settings -> Connections -> Develop integrations (internal)
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Optional explicit data source; otherwise the database must contain exactly one.
NOTION_DATA_SOURCE_ID=

# Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALLOWED_WHATSAPP_NUMBERS=91XXXXXXXXXX
# Meta app -> App settings -> Basic -> App secret
WHATSAPP_APP_SECRET=
# Any string you pick; enter the same one in Meta's webhook "Verify token" box
WHATSAPP_VERIFY_TOKEN=

TIMEZONE=Asia/Kolkata

# Supabase -> project Connect / Settings -> API Keys. Backend only; never VITE_*.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
KOE_OWNER_ID=rohit
# Generate a private app token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required for browser calls when Supabase is configured. Enter it in Koe's access-token field.
KOE_ACCESS_TOKEN=

GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
# Phase 4: existing Google OAuth, with --with-sheets --reauthorize.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Hours
WORKING_HOURS_START=09:00
WORKING_HOURS_END=21:00
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Google Calendar/Sheets: credentials.json + scripts.google_auth, not a Google API key.
# Follow docs/PHASE2_SETUP.md. No database connection string is needed for Supabase REST.
