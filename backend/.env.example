# Copy to .env and fill in. Never commit .env.
# Google AI Studio -> Get API key
GEMINI_API_KEY=

# GitHub -> Settings -> Developer settings -> Fine-grained tokens
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo,owner/other-repo

# Notion -> Settings -> Connections -> Develop integrations (internal)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALLOWED_WHATSAPP_NUMBERS=91XXXXXXXXXX

TIMEZONE=Asia/Kolkata

# Google Calendar/Sheets use credentials.json (OAuth Desktop client) in backend/, not an env var.
