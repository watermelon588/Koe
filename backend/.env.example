# Copy to .env and fill in. Never commit .env.
# Google AI Studio -> Get API key
GEMINI_API_KEY=
# Optional second key, used on 429. Keys in the same Google project share quota.
GEMINI_API_KEY_2=

# Optional free text/tool fallback when Gemini is rate limited, before any tool executes.
# Create locally at https://openrouter.ai/settings/keys ; never paste the key into chat.
OPENROUTER_API_KEY=
# Legacy OPEN_ROUTER_API_KEY is also accepted. Prefer one spelling with a nonempty value.
OPENROUTER_MODEL=openrouter/free

# GitHub -> Settings -> Developer settings -> Fine-grained tokens
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo,owner/other-repo
GITHUB_LOGIN=your-github-username
# Repo -> Settings -> Webhooks -> Secret (any long random string, same value here)
GITHUB_WEBHOOK_SECRET=

# Notion -> Settings -> Connections -> Develop integrations (internal)
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Optional explicit data source; otherwise the database must contain exactly one.
NOTION_DATA_SOURCE_ID=

# Meta for Developers -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ALLOWED_WHATSAPP_NUMBERS=91XXXXXXXXXX
# Meta app -> App settings -> Basic -> App secret
WHATSAPP_APP_SECRET=
# Any string you pick; enter the same one in Meta's webhook "Verify token" box
WHATSAPP_VERIFY_TOKEN=

TIMEZONE=Asia/Kolkata

# Neon -> project Connect -> PostgreSQL connection string (keep SSL parameters).
# Backend only; never VITE_*. Database credentials are not an app login.
DATABASE_URL=
KOE_OWNER_ID=rohit
# Generate a private app token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Development app password for dashboard, chat and calls; see docs/AUTH_FLOW.md for final sign-in.
KOE_ACCESS_TOKEN=

GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary
# Phase 4: existing Google OAuth, with --with-sheets --reauthorize.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Hours
WORKING_HOURS_START=09:00
WORKING_HOURS_END=21:00
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Google Calendar/Sheets: credentials.json + scripts.google_auth, not a Google API key.
# Follow docs/PHASE2_SETUP.md; apply Neon schema with python -m scripts.migrate_store.

# Koe app on Vercel: its https origin(s), comma-separated (CORS). Empty for local dev.
FRONTEND_ORIGINS=

# Push identity for hosts with a wiped disk (Render): uv run python -m scripts.vapid_key
VAPID_PRIVATE_KEY=

# Google sign-in (ACCOUNTS_SPEC.md): a "Web application" OAuth client from Google Cloud → Google Auth Platform.
# Redirect URIs: <site>/auth/google/callback for https://koe-pi.vercel.app and http://localhost:5173.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
KOE_ADMIN_EMAIL=
KOE_PUBLIC_URL=https://koe-pi.vercel.app

# Accounts (ACCOUNTS_SPEC.md): encrypts connection tokens; use the SAME value on Render. 32+ random characters.
KOE_SECRET_KEY=
# Turns a day for friends on the shared Gemini key (the owner is never limited).
KOE_DAILY_TURNS=60

# GitHub connection (docs/DEPLOY.md §7): an OAuth App with callback <site>/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Models tried in order when GEMINI_TEXT_MODEL is overloaded (503).
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview

# Spotify: manual UI only. Leave disabled until developer setup and combined-app policy acceptance.
# Exact registered callback: canonical Koe HTTPS origin + /auth/spotify/callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_ENABLED=false
# Optional development origin override for Google sign-in and CSRF as well as Spotify.
# Spotify rejects localhost callbacks; use a configured HTTPS origin or 127.0.0.1 loopback.
KOE_LOCAL_URL=http://localhost:5173
